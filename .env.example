# === BACKEND (VPS) ===
DATABASE_URL=postgresql://guarus:guarus123@localhost:5432/guarus_energy
JWT_SECRET=mude-esta-chave-para-um-texto-longo-e-seguro-minimo-32-caracteres
INGEST_API_KEY=chave-secreta-do-agente-minimo-16-caracteres
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# A VPS conecta NO agente (WebSocket) para puxar as leituras - não o contrário.
# AGENT_WS_URL deve apontar para o IP da tailnet (Tailscale) do servidor do
# shopping na porta 9200 - não IP público. A maioria dos links comerciais usa
# CGNAT (sem IP público real), então usamos Tailscale para os dois lados se
# enxergarem sem port-forward. Ver docs/CHECKLIST_SERVIDOR.md e
# docs/CHECKLIST_SHOPPING.md.
AGENT_WS_URL=ws://100.x.y.z:9200

# Autentica quem puxa as leituras do agent. NÃO TEM DEFAULT NO CÓDIGO: sem ela,
# a sincronização não inicia (VPS) e o agent nem sobe (shopping). Era assim que
# devia ter sido desde o começo - o valor que servia de default estava publicado
# num repositório público.
#
# Gere um valor novo e use o MESMO nos dois lados:
#   openssl rand -base64 32
AGENT_API_KEY=gere-uma-chave-nova-e-use-a-mesma-nos-dois-lados

# === AGENTE LOCAL (SHOPPING) ===
MQTT_BROKER=mqtt://localhost:1883
# Mesma chave definida acima em AGENT_API_KEY (VPS) - autentica a conexão WebSocket
API_KEY=mesmo-valor-de-AGENT_API_KEY
LOCAL_PORT=9100
WS_PORT=9200

# Credenciais do broker. Vazias = conexão anônima, que só vale para o broker de
# desenvolvimento. No servidor do shopping o `allow_anonymous` está desligado e
# estas variáveis são obrigatórias - ver mosquitto/config/mosquitto.producao.conf.
# Quem publica em `konect/+/readings` decide o consumo que vira fatura.
MQTT_USER=
MQTT_PASS=

# === SEED (opcional) ===
# Sem estas variáveis o seed SORTEIA as senhas e as imprime uma única vez no log.
# Nunca mais commitar senha de seed: as anteriores (admin123/lojista123) ficaram
# ativas em producao e estavam publicadas no README.
SEED_ADMIN_PASSWORD=
SEED_LOJISTA_PASSWORD=

# === POSTGRES ===
DB_USER=guarus
DB_PASSWORD=guarus123
